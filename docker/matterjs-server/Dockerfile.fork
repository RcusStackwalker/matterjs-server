# ── Stage 1: Build ──────────────────────────────────────────────────────────
FROM node:24.15-trixie-slim AS builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /build

# Native module build tools (removed after build via multi-stage)
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 make gcc g++ libbluetooth-dev libudev-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN npm ci --ignore-scripts
RUN npm run build

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM node:24.15-trixie-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        iputils-ping \
        curl \
        bluez \
        libbluetooth3 \
        libcap2-bin \
    && setcap cap_net_raw+ep "$(command -v ping)" \
    && apt-get purge -y --auto-remove libcap2-bin \
    && rm -rf /var/lib/apt/lists/* \
    # Data directory owned by the non-root runtime user
    && mkdir /data \
    && chown 1000:1000 /data

# Copy built monorepo from builder.
# npm workspace symlinks use relative paths (e.g. node_modules/@matter-server/ws-controller
# -> ../../packages/ws-controller). Both node_modules/ and packages/ land as siblings
# under /app/, so the relative symlinks resolve correctly in the runtime image.
COPY --from=builder /build/node_modules ./node_modules
COPY --from=builder /build/packages ./packages

ENV LOG_LEVEL=info
ENV STORAGE_PATH=/data

VOLUME ["/data"]
EXPOSE 5580

COPY --chmod=0755 docker/matterjs-server/healthcheck.sh /usr/local/bin/healthcheck.sh
HEALTHCHECK --interval=60s --timeout=10s --start-period=900s --start-interval=5s --retries=6 \
    CMD ["/usr/local/bin/healthcheck.sh"]

USER 1000:1000
ENTRYPOINT ["node", "--enable-source-maps", \
            "/app/packages/matter-server/dist/esm/MatterServer.js"]
CMD []
